# Postgres (Railway provides this)
DATABASE_URL=postgresql://user:password@localhost:5432/installer_finder

# Redis for the website-enrichment queue (Railway Redis, or Memurai locally)
REDIS_URL=redis://localhost:6379

# Google Places API (New) - keep this on the server only, never in the app
GOOGLE_PLACES_API_KEY=

# Firebase Admin - service account from the NEW Dahua Firebase project
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n for line breaks
FIREBASE_PRIVATE_KEY=

# First admin. Their Firebase account is linked on first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# Meta (Facebook) lead ads - leave blank to switch the integration off
META_APP_SECRET=
# Any long random string; paste the same value in the Meta app's webhook settings
META_VERIFY_TOKEN=
# Long-lived Page access token for the Dahua Facebook Page (leads_retrieval permission)
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
# Country for Facebook leads whose form has no country question (ISO code)
META_DEFAULT_COUNTRY=TT

PORT=4000
# Max Google searches per user per hour (each keyword = one paid search)
PLACES_SEARCH_LIMIT_PER_HOUR=60
